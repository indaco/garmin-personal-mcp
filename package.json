{
  "name": "@indaco/garmin-personal-mcp",
  "version": "0.5.0",
  "description": "MCP server for the official Garmin Connect Personal API",
  "homepage": "https://garmin-personal-mcp.indaco.dev",
  "bugs": "https://github.com/indaco/garmin-personal-mcp/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/indaco/garmin-personal-mcp.git"
  },
  "bin": {
    "garmin-personal-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "prompts",
    "THIRD-PARTY-NOTICES.md"
  ],
  "type": "module",
  "scripts": {
    "build": "tsdown && node scripts/build-template.mjs && node scripts/third-party-notices.mjs",
    "build:site": "tsdown -c tsdown.site.config.ts && node scripts/build-site.mjs",
    "build:all": "pnpm build && node scripts/demo-gif.mjs --if-stale && pnpm build:site",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage",
    "test:page": "vitest run --config vitest.page.config.ts",
    "guide": "UPDATE_DOCS=1 vitest run test/docs.test.ts",
    "demo": "node scripts/demo-gif.mjs",
    "lint": "oxlint --deny-warnings && oxfmt --check",
    "fmt": "oxfmt",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@garmin/fitsdk": "^21.218.0",
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "axe-core": "^4.14.0",
    "chart.js": "^4.6.1",
    "fflate": "^0.8.3",
    "oxfmt": "0.75.0",
    "oxlint": "^1.90.0",
    "playwright-core": "^1.64.1",
    "tsdown": "^0.23.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.15.0"
}
